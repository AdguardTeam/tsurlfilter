# Version control
.git
.gitignore
.gitattributes

# Dependencies (will be installed inside Docker)
node_modules
**/node_modules

# Build cache
.nx
**/.nx

# Build outputs (rebuilt inside Docker)
**/dist
**/*.tgz

# FIXME: undo before merging. The line below un-excludes the vendored
# @adguard/extended-css tarball (referenced by the pnpm.overrides in
# package.json) so it is available during `pnpm install` in the deps stage.
# Remove this rule (and the COPY vendor/ in Dockerfile + the override) once
# the apply bundle is published to npm.
!vendor/*.tgz

# IDE and editor files
.vscode
.idea
*.swp
*.swo

# CI/CD (not needed inside Docker)
# NOTE: only bamboo-specs/scripts/ is used at Docker build time (test helpers).
# bamboo-specs/jobs/ contains Bamboo YAML includes and is NOT referenced in the Dockerfile.
.github
bamboo-specs/jobs

# Git hooks (not needed inside Docker)
.husky

# Test outputs
**/coverage
**/tests-reports

# Docker build output directories (created by bamboo scripts / local verification)
output
output-*

# Misc
*.log
.DS_Store
