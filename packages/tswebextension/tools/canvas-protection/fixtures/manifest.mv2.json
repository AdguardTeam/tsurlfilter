{
    "manifest_version": 2,
    "name": "Canvas delivery test",
    "version": "1.0.0",
    "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "webNavigation", "http://127.0.0.1/*", "http://localhost/*", "http://*.localhost/*"],
    "background": { "scripts": ["background.js"], "persistent": true },
    "incognito": "spanning",
    "browser_specific_settings": {
        "gecko": { "id": "canvas-delivery@tests.invalid", "strict_min_version": "128.0" }
    }
}
